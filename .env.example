DATABASE_URL=postgres://sreops:sreops@127.0.0.1:5432/sreops
# Shared secret Alertmanager sends as "Authorization: Bearer <token>" (http_config.authorization).
WEBHOOK_TOKEN=change-me
# Prometheus HTTP API (in cluster: http://monitoring-kube-prometheus-prometheus.monitoring:9090)
PROMETHEUS_URL=http://localhost:9090
# Grafana base URL for deep links (dashboards, Loki logs). Locally: port-forward svc/monitoring-grafana 3001:80
GRAFANA_URL=http://localhost:3001
# Detection management: rule repo, and a token that can push branches and open PRs on it (contents + pull requests: write).
DETECTION_REPO=s1ns3nz0/lineth-observability
DETECTION_GITHUB_TOKEN=
# Without a token, read rules from a local clone (read-only; no PRs). `npm run repos:sync` clones/updates .repos/.
DETECTION_REPO_DIR=
# Change correlation (F12): Flux notification Provider (type generic-hmac, address <app>/api/flux) signs with this token.
FLUX_WEBHOOK_SECRET=change-me
# CHGs (docs/changes/CHG-*.md frontmatter): a local clone (.repos/lineth-l2-gitops), or the GitHub API with a read token.
GITOPS_REPO_DIR=
GITOPS_REPO=s1ns3nz0/lineth-l2-gitops
GITOPS_GITHUB_TOKEN=
# AI drafts (P2): OpenRouter key (server-side only; set a credit limit on it). Model slug, default in lib/ai.ts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# P2 agents: lineth-tools calls /api/agent/* with AGENT_API_TOKEN; the console calls the executor with EXECUTOR_TOKEN.
AGENT_API_TOKEN=
EXECUTOR_TOKEN=
EXECUTOR_URL=http://localhost:18090
# Kagent controller (A2A), e.g. kubectl -n kagent port-forward svc/kagent-controller 18083:8083
KAGENT_URL=http://localhost:18083
